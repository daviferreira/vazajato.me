---
import Timeline from '../../components/Timeline.astro';
import Layout from '../../layouts/Layout.astro';

import { articlesBySource, sources } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.entries(articlesBySource).map(([source, articles]) => ({
    params: { source },
    props: { articles },
  }));
}

const { source } = Astro.params;
const { articles } = Astro.props;
const { name } = sources[source];
---

<Layout
  title={`Veículo: ${name} | Linha do tempo da #VazaJato`}
  description={`Página listando todas as reportagens da #VazaJato publicadas via ${name}`}
>
  <Timeline articles={articles} source={source} />
</Layout>
