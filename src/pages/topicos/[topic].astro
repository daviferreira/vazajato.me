---
import Timeline from '../../components/Timeline.astro';
import Layout from '../../layouts/Layout.astro';

import { topicsBySlug } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.entries(topicsBySlug).map(([topic, props]) => ({
    params: { topic },
    props,
  }));
}

const { articles, label } = Astro.props;
---

<Layout
  title={`Tópico: ${label} | Linha do tempo da #VazaJato`}
  description={`Página listando todas as reportagens da #VazaJato sobre ${label}`}
>
  <Timeline articles={articles} topic={label} />
</Layout>
