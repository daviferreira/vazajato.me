---
import Timeline from '../../components/Timeline.astro';
import Layout from '../../layouts/Layout.astro';

import { topicsBySlug } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.entries(topicsBySlug).map(([topic, props]) => ({
    params: { topic },
    props,
  }));
}

const { articles, label } = Astro.props;
---

<Layout
  title={`${label} | Linha do tempo da Vaza Jato`}
  description={`Todas as reportagens da Vaza Jato sobre ${label}.`}
>
  <Timeline articles={articles} topic={label} title={label} />
</Layout>
