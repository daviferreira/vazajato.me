---
import { Image } from 'astro:assets';

import Icon from './Icon.astro';

import { slug, sourceImage, sourceKeys, sources, topics } from '../lib/data.js';

// `source` is a key of sources.json, `topic` a topic label; both optional.
const { source, topic } = Astro.props;
---

<div class="filters" role="group" aria-label="Filtros">
  <div class="filter">
    <details name="filter">
      <summary class:list={['control', { active: source }]}>
        <span class:list={['value', { highlight: source }]}>
          {source ? (
            sources[source].name
          ) : (
            <>
              <span class="long">Todos os veículos</span>
              <span class="short">Veículo</span>
            </>
          )}
        </span>
        <Icon name="chevron" class="chevron" />
      </summary>
      <ul class="menu">
        {sourceKeys.map((key) => (
          <li>
            <a
              href={`/veiculos/${key}`}
              aria-current={key === source ? 'page' : undefined}
            >
              <Image src={sourceImage[key]} alt="" width={40} height={40} />
              {sources[key].name}
            </a>
          </li>
        ))}
      </ul>
    </details>
    {source && (
      <a class="clear hit" href="/" aria-label="Remover filtro de veículo">
        <Icon name="close" size={16} />
      </a>
    )}
  </div>

  <div class="filter">
    <details name="filter">
      <summary class:list={['control', { active: topic }]}>
        <span class:list={['value', { highlight: topic }]}>
          {topic || (
            <>
              <span class="long">Todos os tópicos</span>
              <span class="short">Tópico</span>
            </>
          )}
        </span>
        <Icon name="chevron" class="chevron" />
      </summary>
      <ul class="menu">
        {topics.map(({ label }) => (
          <li>
            <a
              href={`/topicos/${slug(label)}`}
              aria-current={label === topic ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
    {topic && (
      <a class="clear hit" href="/" aria-label="Remover filtro de tópico">
        <Icon name="close" size={16} />
      </a>
    )}
  </div>

  <button
    class="control sort"
    type="button"
    data-sort
    aria-label="Mais recentes primeiro"
    hidden
  >
    <Icon name="sort" />
    <span class="sort-label" data-sort-label>
      Mais recentes primeiro
    </span>
  </button>
</div>

<script>
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>(
    'details[name="filter"]',
  );

  // Close menus on outside click and on Escape.
  const close = (except?: Element | null) =>
    dropdowns.forEach((d) => {
      if (d !== except) d.open = false;
    });

  document.addEventListener('click', (e) =>
    close((e.target as Element).closest('details[name="filter"]')),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = [...dropdowns].find((d) => d.open);
    close();
    open?.querySelector('summary')?.focus();
  });

  // Sort: flip months and the stories inside them, in every view.
  const button = document.querySelector<HTMLButtonElement>('[data-sort]');
  const label = button.querySelector('[data-sort-label]');
  const reverse = (el: Element) => el.append(...[...el.children].reverse());
  let newestFirst = false;

  button.hidden = false;
  button.addEventListener('click', () => {
    newestFirst = !newestFirst;
    document.documentElement.dataset.order = newestFirst ? 'desc' : 'asc';
    document
      .querySelectorAll(
        '[data-months], [data-cards], [data-list], [data-items]',
      )
      .forEach(reverse);
    document.dispatchEvent(
      new CustomEvent('timeline:sort', { detail: newestFirst }),
    );
    document
      .querySelectorAll('[data-row]')
      .forEach((row) => row.scrollTo({ left: 0 }));
    const text = newestFirst
      ? 'Mais antigas primeiro'
      : 'Mais recentes primeiro';
    label.textContent = text;
    button.setAttribute('aria-label', text);
    window.scrollTo({ top: 0 });
  });
</script>

<style>
  /* Set as type, like a newspaper's section navigation: no boxes. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
  }

  .filter {
    position: relative;
  }

  details {
    position: relative;
  }

  .control {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition:
      min-height 0.3s var(--ease-out),
      font-size 0.3s var(--ease-out);
  }

  .control::-webkit-details-marker {
    display: none;
  }

  .control:hover .value,
  .control:hover .sort-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Compact while the toolbar is pinned. */
  :global([data-stuck]) .control {
    min-height: 36px;
    font-size: 0.875rem;
  }

  .value {
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .short {
    display: none;
  }

  /* An applied filter is marked with the highlighter. */
  .control.active {
    padding-right: 32px;
  }

  .control.active :global(.chevron) {
    display: none;
  }

  :global(.chevron) {
    color: var(--muted);
    transition: transform 0.25s var(--ease-out);
  }

  details[open] :global(.chevron) {
    transform: rotate(180deg);
  }

  .clear {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--muted);
    transform: translateY(-50%);
  }

  .clear:hover {
    color: var(--text);
  }

  .sort {
    color: var(--body);
  }

  .sort :global(svg) {
    color: var(--muted);
  }

  .menu {
    position: absolute;
    top: calc(100% + 2px);
    left: -12px;
    z-index: 20;
    width: max(100%, 300px);
    max-height: min(60vh, 480px);
    overflow-y: auto;
    padding: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 12px 32px oklch(0 0 0 / 0.28);
    list-style: none;
    animation: drop 0.22s var(--ease-out);
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    padding: 8px 10px;
    color: var(--body);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .menu a:hover,
  .menu a:focus-visible {
    background: var(--raised);
    color: var(--text);
  }

  .menu a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  .menu a[aria-current]::after {
    flex: none;
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
    content: '';
  }

  .menu img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  .sort[hidden] {
    display: none;
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 640px) {
    .filters {
      gap: 0 20px;
    }

    .control {
      font-size: 0.875rem;
    }

    .value {
      max-width: 34vw;
    }

    .filter:nth-child(2) .menu {
      right: -12px;
      left: auto;
    }

    .menu {
      width: min(300px, calc(100vw - 32px));
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .sort-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu {
      animation: none;
    }

    .control {
      transition: none;
    }
  }
</style>
