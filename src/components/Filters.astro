---
import { Image } from 'astro:assets';

import Icon from './Icon.astro';

import { slug, sourceImage, sourceKeys, sources, topics } from '../lib/data.js';

// `source` is a key of sources.json, `topic` a topic label; both optional.
const { source, topic } = Astro.props;
---

<div class="filters" role="group" aria-label="Filtros">
  <div class="filter">
    <details name="filter">
      <summary class:list={['control', { active: source }]}>
        <span class:list={['value', { highlight: source }]}>
          {source ? (
            sources[source].name
          ) : (
            <>
              <span class="long">Todos os veículos</span>
              <span class="short">Veículo</span>
            </>
          )}
        </span>
        <Icon name="chevron" class="chevron" />
      </summary>
      <div class="menu">
        <input
          class="find"
          type="search"
          placeholder="Buscar veículo"
          aria-label="Buscar veículo"
          autocomplete="off"
          spellcheck="false"
          data-find
          hidden
        />
        <ul>
          {sourceKeys.map((key) => (
            <li>
              <a
                href={`/veiculos/${key}`}
                aria-current={key === source ? 'page' : undefined}
              >
                <Image src={sourceImage[key]} alt="" width={40} height={40} />
                {sources[key].name}
              </a>
            </li>
          ))}
        </ul>
        <p class="empty" hidden>
          Nada encontrado
        </p>
      </div>
    </details>
    {source && (
      <a class="clear hit" href="/" aria-label="Remover filtro de veículo">
        <Icon name="close" size={16} />
      </a>
    )}
  </div>

  <div class="filter">
    <details name="filter">
      <summary class:list={['control', { active: topic }]}>
        <span class:list={['value', { highlight: topic }]}>
          {topic || (
            <>
              <span class="long">Todos os tópicos</span>
              <span class="short">Tópico</span>
            </>
          )}
        </span>
        <Icon name="chevron" class="chevron" />
      </summary>
      <div class="menu">
        <input
          class="find"
          type="search"
          placeholder="Buscar tópico"
          aria-label="Buscar tópico"
          autocomplete="off"
          spellcheck="false"
          data-find
          hidden
        />
        <ul>
          {topics.map(({ label }) => (
            <li>
              <a
                href={`/topicos/${slug(label)}`}
                aria-current={label === topic ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <p class="empty" hidden>
          Nada encontrado
        </p>
      </div>
    </details>
    {topic && (
      <a class="clear hit" href="/" aria-label="Remover filtro de tópico">
        <Icon name="close" size={16} />
      </a>
    )}
  </div>

  <button
    class="control sort"
    type="button"
    data-sort
    aria-label="Mais recentes primeiro"
    hidden
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path class="arrow-up" d="M8 4v16M4 8l4-4 4 4" />
      <path class="arrow-down" d="M16 20V4M12 16l4 4 4-4" />
    </svg>
    <span class="sort-label" data-sort-label>
      Mais recentes primeiro
    </span>
  </button>
</div>

<script>
  import { fold } from '../lib/search.js';

  const dropdowns = document.querySelectorAll<HTMLDetailsElement>(
    'details[name="filter"]',
  );

  // Close menus on outside click and on Escape.
  const close = (except?: Element | null) =>
    dropdowns.forEach((d) => {
      if (d !== except) d.open = false;
    });

  document.addEventListener('click', (e) =>
    close((e.target as Element).closest('details[name="filter"]')),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = [...dropdowns].find((d) => d.open);
    close();
    open?.querySelector('summary')?.focus();
  });

  // Type to narrow a menu; Enter opens the first match, arrows walk the list.
  dropdowns.forEach((details) => {
    const input = details.querySelector<HTMLInputElement>('[data-find]');
    const empty = details.querySelector<HTMLElement>('.empty');
    const items = [...details.querySelectorAll<HTMLLIElement>('li')].map(
      (li) => ({ li, text: fold(li.textContent) }),
    );
    const visible = () =>
      items
        .filter(({ li }) => !li.hidden)
        .map(({ li }) => li.querySelector('a'));

    input.hidden = false;

    details.addEventListener('toggle', () => {
      if (!details.open) return;
      input.value = '';
      input.dispatchEvent(new Event('input'));
      // Skip on touch so the keyboard doesn't cover the list.
      if (matchMedia('(hover: hover)').matches) input.focus();
    });

    input.addEventListener('input', () => {
      const words = fold(input.value).split(/\s+/).filter(Boolean);
      items.forEach(({ li, text }) => {
        li.hidden = !words.every((w) => text.includes(w));
      });
      empty.hidden = visible().length > 0;
    });

    details.addEventListener('keydown', (e) => {
      const links = visible();
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Enter' && e.target === input && !e.isComposing) {
        e.preventDefault();
        links[0]?.click();
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const next = at + (e.key === 'ArrowDown' ? 1 : -1);
        if (next < 0) input.focus();
        else links[Math.min(next, links.length - 1)]?.focus();
      }
    });
  });

  // Sort: flip months and the stories inside them, in every view.
  const button = document.querySelector<HTMLButtonElement>('[data-sort]');
  const label = button.querySelector('[data-sort-label]');
  const reverse = (el: Element) => el.append(...[...el.children].reverse());
  let newestFirst = false;

  button.hidden = false;
  button.addEventListener('click', () => {
    newestFirst = !newestFirst;
    document.documentElement.dataset.order = newestFirst ? 'desc' : 'asc';
    document
      .querySelectorAll(
        '[data-months], [data-cards], [data-list], [data-items]',
      )
      .forEach(reverse);
    document.dispatchEvent(
      new CustomEvent('timeline:sort', { detail: newestFirst }),
    );
    document
      .querySelectorAll('[data-row]')
      .forEach((row) => row.scrollTo({ left: 0 }));
    const text = newestFirst
      ? 'Mais antigas primeiro'
      : 'Mais recentes primeiro';
    label.textContent = text;
    button.setAttribute('aria-label', text);
    window.scrollTo({ top: 0 });
  });
</script>

<style>
  /* Set as type, like a newspaper's section navigation: no boxes. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
  }

  .filter {
    position: relative;
  }

  details {
    position: relative;
  }

  .control {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition:
      min-height 0.3s var(--ease-out),
      font-size 0.3s var(--ease-out);
  }

  .control::-webkit-details-marker {
    display: none;
  }

  .control:hover .value,
  .control:hover .sort-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Compact while the toolbar is pinned. */
  :global([data-stuck]) .control {
    min-height: 36px;
    font-size: 0.875rem;
  }

  .value {
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .short {
    display: none;
  }

  /* An applied filter is marked with the highlighter. */
  .control.active {
    padding-right: 32px;
  }

  .control.active :global(.chevron) {
    display: none;
  }

  :global(.chevron) {
    color: var(--muted);
    transition: transform 0.25s var(--ease-out);
  }

  details[open] :global(.chevron) {
    transform: rotate(180deg);
  }

  .clear {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--muted);
    transform: translateY(-50%);
  }

  .clear:hover {
    color: var(--text);
  }

  .sort {
    color: var(--body);
  }

  /* The lit arrow names the order on screen: up oldest first, down newest. */
  .sort path {
    color: var(--text);
    opacity: 0.35;
    transition: opacity 0.25s var(--ease-out);
  }

  .sort .arrow-up,
  :global(:root[data-order='desc']) .sort .arrow-down {
    opacity: 1;
  }

  :global(:root[data-order='desc']) .sort .arrow-up {
    opacity: 0.35;
  }

  .menu {
    position: absolute;
    top: calc(100% + 2px);
    left: -12px;
    z-index: 20;
    width: max(100%, 300px);
    max-height: min(60vh, 480px);
    overflow-y: auto;
    padding: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 12px 32px oklch(0 0 0 / 0.28);
    list-style: none;
    transform-origin: top left;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  /* Enter from above; on close, keep the content rendered until it fades. */
  details:not([open]) .menu {
    opacity: 0;
    transform: translateY(-8px) scale(0.97);
    transition-duration: 0.2s;
  }

  @starting-style {
    details[open] .menu {
      opacity: 0;
      transform: translateY(-12px) scale(0.96);
    }
  }

  details::details-content {
    transition: content-visibility 0.2s allow-discrete;
  }

  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .find {
    position: sticky;
    top: -6px;
    z-index: 1;
    width: 100%;
    min-height: 44px;
    margin: -6px 0 6px;
    padding: 0 10px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    outline: none;
  }

  .find:focus {
    border-bottom-color: var(--accent);
  }

  .find::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .find[hidden],
  .empty[hidden] {
    display: none;
  }

  .empty {
    padding: 12px 10px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    padding: 8px 10px;
    color: var(--body);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .menu a:hover,
  .menu a:focus-visible {
    background: var(--raised);
    color: var(--text);
  }

  .menu a[aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  .menu a[aria-current]::after {
    flex: none;
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
    content: '';
  }

  .menu img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  .sort[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .filters {
      gap: 0 20px;
    }

    .control {
      font-size: 0.875rem;
    }

    .value {
      max-width: 34vw;
    }

    .filter:nth-child(2) .menu {
      right: -12px;
      left: auto;
      transform-origin: top right;
    }

    .menu {
      width: min(300px, calc(100vw - 32px));
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .sort-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .sort path,
    details::details-content {
      transition: none;
    }

    .control {
      transition: none;
    }
  }
</style>
