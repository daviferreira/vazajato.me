---
import { Image } from 'astro:assets';

import { articleImage, formatDate, sourceImage, sources } from '../lib/data.js';

const { articleId, publishDate, source, title, topics, url } = Astro.props;
const { color, name } = sources[source];
const tags = topics.filter(Boolean);
---

<article class="card" style={`--outlet: ${color}`}>
  <div class="cover">
    <Image
      src={articleImage[articleId]}
      alt=""
      widths={[340, 680]}
      sizes="340px"
    />
  </div>
  <div class="body">
    <time class="date mono" datetime={publishDate}>
      {formatDate(publishDate)}
    </time>
    <h3>
      <a class="stretched" href={url} rel="noopener noreferrer" target="_blank">
        {title}
        <span class="visually-hidden">(abre em nova aba)</span>
      </a>
    </h3>
    <p class="source">
      <Image src={sourceImage[source]} alt="" width={40} height={40} />
      <span>{name}</span>
    </p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((topic) => (
          <li class="mono">{topic}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--body);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    box-shadow: 0 14px 30px -12px oklch(0 0 0 / 0.45);
    transform: translateY(-4px);
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .cover {
    aspect-ratio: 2 / 1;
    overflow: hidden;
    /* The outlet's colour: behind the cover while it loads, and as a strip. */
    border-bottom: 3px solid var(--outlet);
    background: var(--outlet);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 16px 18px 18px;
  }

  /* A dateline, not a tag: plain mono above the title. */
  .date {
    margin-bottom: -6px;
    color: var(--muted);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
  }

  .source {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .source img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 4px 7px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--muted);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
