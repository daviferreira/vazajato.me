---
import Article from './Article.astro';

import { formatDay, sources } from '../lib/data.js';

import styles from './Day.module.css';

const { articles, day, left } = Astro.props;
---

<div class:list={[styles.root, left ? styles.left : styles.right]}>
  <div class={styles.indicator}>
    <div class={styles.circle}></div>
    <time class={styles.day} datetime={day}>
      {formatDay(day)}
    </time>
  </div>
  <div class={styles.articles}>
    {articles.map((article) => (
      <div
        class={styles.article}
        style={{ borderBottomColor: sources[article.source].color }}
      >
        <Article {...article} />
      </div>
    ))}
  </div>
</div>
