---
import Article from './Article.astro';
import Icon from './Icon.astro';

import { monthTitle, sources } from '../lib/data.js';
import { searchText } from '../lib/search.js';

const { articles, first, month } = Astro.props;
const title = monthTitle(month);
const id = `mes-${month}`;
const count = `${articles.length} ${articles.length === 1 ? 'reportagem' : 'reportagens'}`;
---

<section class="month" aria-labelledby={id} data-search-group>
  <header class="head">
    <h2 id={id}>{title}</h2>
    <span class="count" data-search-count>
      {count}
    </span>
    <div class="nav" data-row-nav hidden>
      <button type="button" aria-label={`Anteriores de ${title}`} data-prev>
        <Icon name="left" size={20} />
      </button>
      <button type="button" aria-label={`Próximas de ${title}`} data-next>
        <Icon name="right" size={20} />
      </button>
    </div>
  </header>
  <div class="row" data-row tabindex="0" role="region" aria-label={title}>
    <ul class="cards" style={`--total: ${articles.length}`} data-cards>
      {articles.map((article, i) => (
        <li data-search={searchText(article, sources[article.source].name)}>
          <Article {...article} priority={first && i === 0} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .month {
    padding-block: clamp(32px, 4vw, 56px) 0;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-inline: var(--gutter);
  }

  h2 {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .count {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px 16px;
    }

    h2 {
      white-space: nowrap;
    }

    .count {
      grid-row: 2;
    }

    .nav {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }

  .nav {
    display: flex;
    gap: 8px;
    margin-left: auto;
    align-self: center;
  }

  .nav[hidden] {
    display: none;
  }

  /* Ink-ringed buttons with no fill; the accent fills them under the
     pointer; a muted outline once there is nothing more that way. */
  .nav button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--text);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.25s var(--ease-out);
  }

  .nav button:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .nav button:active:not(:disabled) {
    transform: scale(0.94);
  }

  .nav button:disabled {
    border-color: var(--line-strong);
    background: transparent;
    color: var(--muted);
    cursor: default;
    opacity: 0.6;
  }

  /* Registered so the fades can ease in and out. */
  @property --fade-before {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-after {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .row {
    --fade: calc(var(--gutter) + 64px);
    /* The right fade is on from the first paint; the script clears it for
       rows that fit or are scrolled to the end. */
    --fade-after: var(--fade);

    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    /* The scrollport fades out on any side that has more cards. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-before),
      #000 calc(100% - var(--fade-after)),
      transparent
    );
  }

  /* Ease only once measured, so nothing animates in on load. */
  .row[data-measured] {
    transition:
      --fade-before 0.3s,
      --fade-after 0.3s;
  }

  .row[data-more-before] {
    --fade-before: var(--fade);
  }

  .row[data-at-end] {
    --fade-after: 0px;
  }

  .row::-webkit-scrollbar {
    display: none;
  }

  .row:focus-visible {
    outline-offset: -2px;
  }

  .cards {
    display: flex;
    width: max-content;
    padding: 24px var(--gutter) 32px;
    list-style: none;
    /* Each card's position in the row; search updates --total, and hidden
       cards don't count, so numbers stay right whatever is filtered. */
    counter-reset: card total var(--total);
  }

  .cards li:not([hidden]) {
    counter-increment: card;
  }

  /* "1/1" says nothing: drop it when only one card is showing. */
  .cards:not(:has(li:not([hidden]) ~ li:not([hidden]))) :global(.position) {
    display: none;
  }

  /* Entries are columns divided by hairline rules, not boxes. */
  .cards li {
    box-sizing: content-box;
    width: min(320px, 74vw);
    padding-inline: 28px;
    border-left: 1px solid var(--line);
    scroll-snap-align: start;
  }

  /* The first visible entry, so it still holds when search hides some. */
  .cards li:nth-child(1 of :not([hidden])) {
    padding-left: 0;
    border-left: 0;
  }

  /* Phones: one card at a time, snapped to the middle, with a slice of
     its neighbours showing at both sides. A light fade softens the edges. */
  @media (max-width: 640px) {
    .row {
      --card: min(400px, calc(100vw - 80px));
      --space: 8px;
      /* No edge fade: the dimmed neighbours do that job. */
      --fade: 0px;
      scroll-padding-inline: 0;
    }

    /* Room enough for the first and last cards to reach the middle. */
    .cards {
      padding-inline: calc((100vw - var(--card)) / 2 - var(--space));
    }

    /* Tighter gap and no rules, so the neighbours actually peek in. */
    .cards li,
    .cards li:nth-child(1 of :not([hidden])) {
      width: var(--card);
      padding-inline: var(--space);
      border-left: 0;
      scroll-snap-align: center;
    }

    /* Dim the neighbours: opacity follows each card's place in the row,
       full in the middle. Without scroll timelines all stay at full. */
    @supports (animation-timeline: view()) {
      .cards li {
        /* Longhands: the minifier folds a shorthand + timeline into an
           invalid animation shorthand. */
        animation-name: focus;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(inline);
      }
    }
  }

  @keyframes focus {
    0%,
    100% {
      opacity: 0.4;
    }

    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row {
      scroll-behavior: auto;
      transition: none;
    }

    .nav button {
      transition: none;
    }
  }
</style>
