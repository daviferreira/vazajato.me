---
import { Image } from 'astro:assets';

import {
  articleImage,
  formatDate,
  groupByMonth,
  monthTitle,
  sourceImage,
  sources,
} from '../lib/data.js';

// A news-site feed: cover left, kicker, headline and byline right.
const { articles } = Astro.props;
---

<div data-list>
  {groupByMonth(articles).map(({ month, articles }) => (
    <section class="group" aria-labelledby={`lista-${month}`}>
      <header class="head">
        <h2 id={`lista-${month}`}>{monthTitle(month)}</h2>
        <span class="count mono">
          {articles.length}{' '}
          {articles.length === 1 ? 'reportagem' : 'reportagens'}
        </span>
      </header>
      <ol class="stories" data-items>
        {articles.map(
          ({ articleId, publishDate, source, title, topics, url }) => {
            const tags = topics.filter(Boolean);
            return (
              <li>
                <article class="story">
                  <span
                    class="cover"
                    style={`--outlet: ${sources[source].color}`}
                  >
                    <Image
                      src={articleImage[articleId]}
                      alt=""
                      widths={[420, 840]}
                      sizes="(min-width: 760px) 420px, 100vw"
                    />
                  </span>
                  <span class="text">
                    {tags.length > 0 && (
                      <span class="kicker">{tags.join(' · ')}</span>
                    )}
                    <h3 class="headline">
                      <a
                        class="stretched"
                        href={url}
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        {title}
                        <span class="visually-hidden">(abre em nova aba)</span>
                      </a>
                    </h3>
                    <span class="byline">
                      <span class="outlet">
                        <Image
                          src={sourceImage[source]}
                          alt=""
                          width={40}
                          height={40}
                        />
                        {sources[source].name}
                      </span>
                      <span aria-hidden="true">—</span>
                      <time datetime={publishDate}>
                        {formatDate(publishDate)}
                      </time>
                    </span>
                  </span>
                </article>
              </li>
            );
          },
        )}
      </ol>
    </section>
  ))}
</div>

<style>
  .group {
    padding: 24px var(--gutter) 8px;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line-strong);
  }

  h2 {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .count {
    color: var(--muted);
  }

  .stories {
    padding: 0;
    list-style: none;
  }

  .stories li + li {
    border-top: 1px solid var(--line);
  }

  .story {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
    padding: 28px 0;
    color: var(--body);
    text-decoration: none;
  }

  .cover {
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--outlet);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease-out);
  }

  .story:hover .cover img {
    transform: scale(1.03);
  }

  .text {
    display: grid;
    gap: 10px;
  }

  .kicker {
    color: var(--body);
    font-size: 1rem;
    font-weight: 500;
  }

  .outlet {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .outlet img {
    flex: none;
  }

  .headline {
    color: var(--text);
    font-family: var(--display);
    font-size: clamp(1.375rem, 1.05rem + 1.1vw, 2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .headline a {
    color: inherit;
    text-decoration: none;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .byline img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  @media (max-width: 760px) {
    .story {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover img {
      transition: none;
    }

    .story:hover .cover img {
      transform: none;
    }
  }
</style>
