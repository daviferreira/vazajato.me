---
import Filters from './Filters.astro';
import Footer from './Footer.astro';
import ListView from './ListView.astro';
import Month from './Month.astro';
import SiteHeader from './SiteHeader.astro';
import TableView from './TableView.astro';
import ViewToggle from './ViewToggle.astro';

import { groupByMonth, summary } from '../lib/data.js';

// `title` and `intro` describe the page; `source` / `topic` set the filters.
const { articles, intro, source, title, topic } = Astro.props;
---

<SiteHeader />

<main>
  <div class="intro">
    <h1>
      {title.includes('Vaza Jato') ? (
        <>
          {title.replace('Vaza Jato', '')}
          <mark>Vaza Jato</mark>
        </>
      ) : (
        <mark>{title}</mark>
      )}
    </h1>
    <div class="aside">
      <p class="lede">{intro}</p>
      <p class="summary">
        {summary(articles)}
        {(source || topic) && (
          <>
            . <a href="/">Ver todas</a>
          </>
        )}
      </p>
    </div>
  </div>

  <div class="sentinel" data-toolbar-sentinel aria-hidden="true"></div>
  <div class="toolbar" data-toolbar>
    <Filters source={source} topic={topic} />
    <ViewToggle />
  </div>

  <div class="panels">
    <div class="panel" data-panel="cards" data-months>
      {groupByMonth(articles).map((month) => (
        <Month {...month} />
      ))}
    </div>
    <div class="panel" data-panel="list">
      <ListView articles={articles} />
    </div>
    <div class="panel" data-panel="table">
      <TableView articles={articles} />
    </div>
  </div>
</main>

<Footer />

<script>
  // Mark the toolbar while it is pinned so it can compact itself.
  const toolbar = document.querySelector<HTMLElement>('[data-toolbar]');
  const sentinel = document.querySelector('[data-toolbar-sentinel]');
  const pins = matchMedia('(min-width: 641px)');
  new IntersectionObserver(([entry]) =>
    toolbar.toggleAttribute(
      'data-stuck',
      pins.matches && !entry.isIntersecting && entry.boundingClientRect.top < 0,
    ),
  ).observe(sentinel);

  // Row arrows: scroll by one viewport of cards, disabled at either end.
  document.querySelectorAll('.month').forEach((month) => {
    const row = month.querySelector<HTMLElement>('[data-row]');
    const nav = month.querySelector<HTMLElement>('[data-row-nav]');
    const prev = month.querySelector<HTMLButtonElement>('[data-prev]');
    const next = month.querySelector<HTMLButtonElement>('[data-next]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    const update = () => {
      const max = row.scrollWidth - row.clientWidth;
      nav.hidden = max < 4;
      prev.disabled = row.scrollLeft < 4;
      next.disabled = row.scrollLeft > max - 4;
      // Edge fades show where there is more to scroll.
      row.toggleAttribute('data-more-before', !prev.disabled);
      row.toggleAttribute('data-more-after', max >= 4 && !next.disabled);
    };

    const page = (direction: number) =>
      row.scrollBy({
        left: direction * row.clientWidth * 0.85,
        behavior: reduce.matches ? 'auto' : 'smooth',
      });

    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    row.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(row);
  });
</script>

<style>
  .intro {
    display: grid;
    gap: 14px;
    padding: clamp(36px, 6vw, 88px) var(--gutter) clamp(20px, 3vw, 44px);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .aside {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 1100px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 760px);
      align-items: last baseline;
      column-gap: 48px;
    }
  }

  .lede {
    max-width: 62ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    color: var(--body);
    text-wrap: pretty;
  }

  .summary {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .summary a {
    color: var(--text);
    text-underline-offset: 3px;
  }

  .summary a:hover {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding: 12px var(--gutter);
    border-bottom: 1px solid transparent;
    background: var(--bg);
    transition:
      padding 0.3s var(--ease-out),
      border-color 0.3s;
  }

  /* Pinned while scrolling; phones skip it, where it would take two rows. */
  @media (min-width: 641px) {
    .toolbar {
      position: sticky;
      top: 0;
      z-index: 30;
    }
  }

  /* The hairline only appears once pinned, to separate it from what scrolls. */
  .toolbar[data-stuck] {
    padding-block: 8px;
    border-bottom-color: var(--line);
  }

  .sentinel {
    height: 1px;
    margin-bottom: -1px;
  }

  .panels {
    padding-bottom: 32px;
  }

  /* The pinned toolbar is shorter. Without this, scroll anchoring shifts the
     page to compensate, which unpins it, and it loops at the threshold. */
  .toolbar,
  .panels {
    overflow-anchor: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .toolbar {
      transition: none;
    }
  }

  /* Cards show by default and without JS; <html data-view> picks another. */
  .panel[data-panel='list'],
  .panel[data-panel='table'],
  :global(html[data-view='list']) .panel[data-panel='cards'],
  :global(html[data-view='table']) .panel[data-panel='cards'] {
    display: none;
  }

  :global(html[data-view='list']) .panel[data-panel='list'],
  :global(html[data-view='table']) .panel[data-panel='table'] {
    display: block;
  }
</style>
