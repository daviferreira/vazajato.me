---
import { Image } from 'astro:assets';

import Icon from './Icon.astro';

import { formatDate, slug, sourceImage, sources } from '../lib/data.js';

const { articles } = Astro.props;

// Sortable columns; rows carry the matching data-* key.
const columns = [
  { key: 'date', label: 'Data' },
  { key: 'title', label: 'Título' },
  { key: 'outlet', label: 'Veículo' },
];
---

<div
  class="scroll"
  tabindex="0"
  role="region"
  aria-label="Tabela de reportagens"
>
  <table>
    <thead>
      <tr>
        {columns.map(({ key, label }) => (
          <th
            scope="col"
            aria-sort={key === 'date' ? 'ascending' : undefined}
            data-column={key}
          >
            <button type="button" data-sort-column={key}>
              {label}
              <Icon name="up" size={14} class="arrow up" />
              <Icon name="down" size={14} class="arrow down" />
            </button>
          </th>
        ))}
        <th scope="col">Tópicos</th>
      </tr>
    </thead>
    <tbody data-table-rows>
      {articles.map(({ publishDate, source, title, topics, url }) => (
        <tr
          data-date={publishDate}
          data-title={title}
          data-outlet={sources[source].name}
        >
          <td class="date mono">
            <time datetime={publishDate}>{formatDate(publishDate)}</time>
          </td>
          <td class="title">
            <a href={url} rel="noopener noreferrer" target="_blank">
              {title}
              <span class="visually-hidden">(abre em nova aba)</span>
            </a>
          </td>
          <td class="outlet">
            <a href={`/veiculos/${source}`}>
              <Image src={sourceImage[source]} alt="" width={40} height={40} />
              {sources[source].name}
            </a>
          </td>
          <td class="topics mono">
            {topics.filter(Boolean).map((topic, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={`/topicos/${slug(topic)}`}>{topic}</a>
              </>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Column sorting. Rows keep their original index to break ties stably.
  const table = document
    .querySelector<HTMLTableElement>('[data-table-rows]')
    ?.closest('table');

  if (table) {
    const body = table.querySelector('tbody');
    const rows = [...body.rows];
    rows.forEach((row, i) => (row.dataset.index = String(i)));
    const collator = new Intl.Collator('pt-BR', {
      sensitivity: 'base',
      ignorePunctuation: true,
    });

    const sort = (key: string, ascending: boolean) => {
      const sign = ascending ? 1 : -1;
      rows.sort(
        (a, b) =>
          sign * collator.compare(a.dataset[key], b.dataset[key]) ||
          sign * (Number(a.dataset.index) - Number(b.dataset.index)),
      );
      body.append(...rows);
      table.querySelectorAll<HTMLElement>('th[data-column]').forEach((th) => {
        if (th.dataset.column === key) {
          th.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
        } else {
          th.removeAttribute('aria-sort');
        }
      });
    };

    table
      .querySelectorAll<HTMLButtonElement>('[data-sort-column]')
      .forEach((button) =>
        button.addEventListener('click', () => {
          const th = button.closest('th');
          sort(
            button.dataset.sortColumn,
            th.getAttribute('aria-sort') !== 'ascending',
          );
        }),
      );

    // The toolbar's sort button orders every view by date.
    document.addEventListener('timeline:sort', (event) =>
      sort('date', !(event as CustomEvent<boolean>).detail),
    );
  }
</script>

<style>
  .scroll {
    overflow-x: auto;
    padding: 8px var(--gutter) 24px;
  }

  .scroll:focus-visible {
    outline-offset: -2px;
  }

  table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 14px 24px 14px 0;
    text-align: left;
    vertical-align: baseline;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  th button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: -6px 0 -6px -6px;
    padding: 6px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  th button:hover,
  th[aria-sort] button {
    color: var(--text);
  }

  /* Arrows: hidden until hover on idle columns; one shows on the sorted one. */
  th :global(.arrow) {
    display: none;
  }

  th:not([aria-sort]) button:hover :global(.up),
  th[aria-sort='ascending'] :global(.up),
  th[aria-sort='descending'] :global(.down) {
    display: block;
  }

  th:not([aria-sort]) button:hover :global(.up) {
    color: var(--muted);
  }

  th {
    padding-top: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  td {
    border-bottom: 1px solid var(--line);
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .date {
    width: 8.5rem;
    color: var(--text);
    white-space: nowrap;
  }

  .title {
    position: relative;
  }

  .title a {
    color: var(--text);
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .outlet {
    width: 14rem;
    color: var(--body);
    white-space: nowrap;
  }

  .outlet img {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: -4px;
  }

  .outlet a,
  .topics a {
    color: inherit;
    text-decoration: none;
  }

  .outlet a:hover,
  .topics a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topics {
    width: 16rem;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
