---
import { Image } from 'astro:assets';

import { formatDate, slug, sourceImage, sources } from '../lib/data.js';

const { articles } = Astro.props;
---

<div
  class="scroll"
  tabindex="0"
  role="region"
  aria-label="Tabela de reportagens"
>
  <table>
    <thead>
      <tr>
        <th scope="col">Data</th>
        <th scope="col">Título</th>
        <th scope="col">Veículo</th>
        <th scope="col">Tópicos</th>
      </tr>
    </thead>
    <tbody data-items>
      {articles.map(({ publishDate, source, title, topics, url }) => (
        <tr>
          <td class="date mono">
            <time datetime={publishDate}>{formatDate(publishDate)}</time>
          </td>
          <td class="title">
            <a href={url} rel="noopener noreferrer" target="_blank">
              {title}
              <span class="visually-hidden">(abre em nova aba)</span>
            </a>
          </td>
          <td class="outlet">
            <a href={`/veiculos/${source}`}>
              <Image src={sourceImage[source]} alt="" width={40} height={40} />
              {sources[source].name}
            </a>
          </td>
          <td class="topics mono">
            {topics.filter(Boolean).map((topic, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={`/topicos/${slug(topic)}`}>{topic}</a>
              </>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .scroll {
    overflow-x: auto;
    padding: 8px var(--gutter) 24px;
  }

  .scroll:focus-visible {
    outline-offset: -2px;
  }

  table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 14px 24px 14px 0;
    text-align: left;
    vertical-align: baseline;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  th {
    padding-top: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  td {
    border-bottom: 1px solid var(--line);
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .date {
    width: 8.5rem;
    color: var(--text);
    white-space: nowrap;
  }

  .title {
    position: relative;
  }

  .title a {
    color: var(--text);
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .outlet {
    width: 14rem;
    color: var(--body);
    white-space: nowrap;
  }

  .outlet img {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: -4px;
  }

  .outlet a,
  .topics a {
    color: inherit;
    text-decoration: none;
  }

  .outlet a:hover,
  .topics a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topics {
    width: 16rem;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
