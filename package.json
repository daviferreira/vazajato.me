{
  "name": "vazajato",
  "private": true,
  "description": "Página listando todas as reportagens da #VazaJato.",
  "version": "0.1.0",
  "author": "Davi Ferreira <hi@daviferreira.com>",
  "dependencies": {
    "@reach/menu-button": "^0.18.0",
    "classnames": "^2.5.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-react-helmet-canonical-urls": "^1.4.0",
    "gatsby-plugin-react-svg": "^3.3.0",
    "gatsby-plugin-remove-serviceworker": "^1.0.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "lodash.groupby": "^4.6.0",
    "lodash.map": "^4.6.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-intersection-observer": "^11.0.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "csvtojson": "^2.0.14",
    "domino": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-react": "^13.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "image-downloader": "^4.3.1",
    "lint-staged": "^17.6.0",
    "moment": "^2.31.0",
    "page-metadata-parser": "^1.1.4",
    "prettier": "^3.10.1",
    "short-uuid": "^6.0.3",
    "signale": "^1.4.0",
    "slugify": "^1.6.9",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "stylelint-order": "^8.1.3"
  },
  "engines": {
    "node": "26.13.1"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "build": "GATSBY_EXPERIMENTAL_PAGE_BUILD_ON_DATA_CHANGES=true gatsby build --log-pages",
    "develop": "gatsby develop --port 4000",
    "format": "prettier --write '**/*.{js,css,json}'",
    "clean": "gatsby clean",
    "prepare": "husky",
    "start": "pnpm run develop",
    "serve": "gatsby serve",
    "lint": "eslint . --cache --cache-location node_modules/.eslintcache && prettier --check '**/*.{js,css,json}' && stylelint './src/**/*.css'",
    "test": "pnpm run lint",
    "import": "node ./tasks/import"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daviferreira/vazajato.me"
  },
  "bugs": {
    "url": "https://github.com/daviferreira/vazajato.me/issues"
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint",
      "prettier --check"
    ],
    "**/*.css": [
      "prettier --check",
      "stylelint"
    ],
    "**/*.json": [
      "prettier --check"
    ]
  },
  "packageManager": "pnpm@12.18.0"
}
